---
const servicePages = [
  '/sofa-cleaning-buffalo-ny',
  '/mattress-cleaning-buffalo-ny',
  '/chair-cleaning-buffalo-ny',
  '/car-interior-cleaning-buffalo-ny',
];
// build.format: 'file' means Astro.url.pathname is the output file path
// (e.g. "/sofa-cleaning-buffalo-ny.html") at build time, not the clean
// Cloudflare-redirected URL -- strip the .html suffix before comparing.
const currentPath = Astro.url.pathname.replace(/\.html$/, '');
const isServicePage = servicePages.includes(currentPath);
const quoteHref = isServicePage ? '#quote' : '/#contact';
---

<nav class="site-nav" aria-label="Main navigation">
  <a href="/" class="logo">
    <img src="/images/logo.png" alt="Fresh Nest Upholstery Cleaning logo" height="42" />
    <div class="logo-text">
      <b>Fresh <span>Nest</span></b>
      <small>Upholstery Cleaning</small>
    </div>
  </a>
  <ul class="nav-links">
    <li><a href="/#services">Services</a></li>
    <li><a href="/#gallery">Before &amp; After</a></li>
    <li><a href="/#process">Process</a></li>
    <li><a href="/tips" aria-current={currentPath === "/tips" ? "page" : undefined}>Cleaning Tips</a></li>
    <li><a href={quoteHref} class="btn-book">Get a Quote</a></li>
  </ul>
  <a class="mobile-tips-link" href="/tips" aria-current={currentPath === '/tips' ? 'page' : undefined}>Cleaning Tips</a>
</nav>

<style>
  .mobile-tips-link { display: none; }
  .nav-links a[aria-current="page"] { color: #2D6A4F; text-decoration: underline; text-underline-offset: 4px; }
  @media (min-width: 901px) and (max-width: 1100px) { .site-nav .nav-links { gap: 16px; } }
  @media (max-width: 900px) {
    .site-nav .nav-links { display: none; }
    .mobile-tips-link { display: inline-flex; align-items: center; justify-content: center; min-height: 44px; padding: 8px 10px; border: 1px solid #2D6A4F; border-radius: 12px; color: #2D6A4F; font-size: 13px; font-weight: 600; text-decoration: none; flex-shrink: 0; }
    .mobile-tips-link:hover, .mobile-tips-link[aria-current="page"] { background: #D8F3DC; }
    .mobile-tips-link:focus-visible { outline: 2px solid #2D6A4F; outline-offset: 3px; }
    .site-nav { gap: 8px; }
  }
  @media (max-width: 380px) {
    .site-nav .logo { gap: 6px; }
    .site-nav .logo img { height: 34px; }
    .site-nav .logo-text b { font-size: 18px; }
    .site-nav .logo-text small { font-size: 10px; }
    .mobile-tips-link { padding-inline: 8px; font-size: 12px; }
  }
</style>
